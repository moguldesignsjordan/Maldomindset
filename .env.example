# PayPal credentials — get these from https://developer.paypal.com/dashboard/applications
# Use Sandbox values for testing, Live values for real payments.

# Public client ID, exposed to the browser by the PayPal JS SDK (Vite requires the VITE_ prefix)
VITE_PAYPAL_CLIENT_ID=

# Same client ID, used server-side by the /api/paypal serverless functions
PAYPAL_CLIENT_ID=

# Secret — server-side only, never expose to the browser
PAYPAL_CLIENT_SECRET=

# https://api-m.sandbox.paypal.com for testing, https://api-m.paypal.com for live
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Firebase (Academy accounts, dashboards) ---
# Client config from Firebase console > Project settings > Your apps > Web app.
# These are public by design; Firestore security rules are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails that become admins when they sign up.
VITE_ADMIN_EMAILS=

# Service account for the serverless functions (Project settings > Service accounts
# > Generate new private key). Keep the private key's \n sequences escaped, and
# wrap the whole value in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
